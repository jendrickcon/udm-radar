# ============================================================================
# UdM-RADAR — .gitignore
# ============================================================================

# --- Config files that may contain real credentials later ---
config/db.php
config/mail.php

# --- Data Privacy & Generated ML Artifacts ---
*.csv
python_ml/*.json
*.pkl
*.joblib

# --- Python / ML pipeline ---
python_ml/__pycache__/
python_ml/*.pyc
python_ml/venv/
python_ml/.venv/
.venv/
__pycache__/
*.py[cod]

# --- PHP dependencies ---
vendor/

# --- Editor / OS junk ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# --- Logs & Env ---
*.log
error_log
.env