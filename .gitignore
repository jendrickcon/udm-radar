# ============================================================================
# UdM-RADAR — .gitignore
# ============================================================================

# --- Config files that may contain real credentials later ---
# db.php/mail.php are currently just defaults, but once real credentials go
# in (e.g. a deployed DB password, real SMTP creds), these must never be
# committed. Track config/*.example.php instead (see README setup steps).
config/db.php
config/mail.php

# --- Python / ML pipeline ---
python_ml/__pycache__/
python_ml/*.pyc
python_ml/venv/
python_ml/.venv/
*.pkl
*.joblib

# --- PHP dependencies (if Composer is ever added) ---
vendor/

# --- Editor / OS junk ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# --- Logs ---
*.log
error_log

# --- Local env files ---
.env

# Python environment and generated bytecode are machine-specific
# and should not be committed to the repository.
.venv/
__pycache__/
*.py[cod]
